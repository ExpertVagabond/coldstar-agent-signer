node_modules/
# dist/ is COMMITTED so `npm install github:ExpertVagabond/coldstar-agent-signer`
# works without a build step (npm does not run `prepare` for git deps reliably).
# Run `npm run build` before committing source changes.
*.log
.DS_Store

# Never commit key material or a filled-in live policy.
*.key
*.keypair.json
coldstar.policy.local.json
.env
.env.*

# Python bytecode from the offline signer tool.
__pycache__/
